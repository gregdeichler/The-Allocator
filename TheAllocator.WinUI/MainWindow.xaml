<Window
    x:Class="TheAllocator.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TheAllocator.Models"
    xmlns:viewModels="using:TheAllocator.WinUI.ViewModels"
    xmlns:converters="using:TheAllocator.WinUI.Converters"
    Title="The Allocator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:NoticeSeverityConverter x:Key="NoticeSeverityConverter" />
            <converters:PreflightGlyphConverter x:Key="PreflightGlyphConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="118"
                   Height="28"
                   Margin="16,0,14,0"
                   HorizontalAlignment="Left"
                   Source="Assets/Vassar_Wordmark_VassarBurgundy_RGB.png"
                   Stretch="Uniform"
                   AutomationProperties.Name="Vassar College" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="The Allocator" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Width="1" Height="16" Background="{ThemeResource AllocatorBorderBrush}" />
                <TextBlock Text="{x:Bind ViewModel.MachineName}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Administrator" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="2"
                    Margin="0,4,148,4"
                    Padding="10,4"
                    Background="Transparent"
                    AutomationProperties.Name="Diagnostics and application information">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="DiagnosticsFlyout"
                                Placement="BottomEdgeAlignedRight"
                                Opening="DiagnosticsFlyout_Opening">
                        <MenuFlyoutItem x:Name="OpenLatestLogMenuItem"
                                        Text="Open latest log"
                                        Click="OpenLatestLog_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="VersionMenuItem" IsEnabled="False" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Home -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsHomeVisible, Mode=OneWay}"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1120" Margin="48,40,48,48" Spacing="28">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Move a Windows profile with confidence"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Choose the role of this computer. The Allocator will guide the technician through setup, safety checks, transfer, and handoff."
                                   FontSize="16"
                                   Style="{StaticResource BodyMutedStyle}"
                                   MaxWidth="760"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <Grid MinHeight="300">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="52" Height="52" CornerRadius="12" Background="{ThemeResource AllocatorSubtleBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE74E;" FontSize="24" Foreground="{ThemeResource AllocatorAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="8">
                                    <TextBlock Text="Back up an old computer" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Capture a user’s portable files, profile details, and selected printers to external storage."
                                               Style="{StaticResource BodyMutedStyle}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,24,0,24" Spacing="8">
                                    <TextBlock Text="1  Choose the user and destination" />
                                    <TextBlock Text="2  Review readiness checks" />
                                    <TextBlock Text="3  Create and verify the package" />
                                </StackPanel>
                                <Button Grid.Row="3"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{x:Bind ViewModel.StartBackupCommand}"
                                        AccessKey="B"
                                        Content="Set up backup" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <Grid MinHeight="300">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="52" Height="52" CornerRadius="12" Background="{ThemeResource AllocatorSubtleBrush}" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource AllocatorAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="8">
                                    <TextBlock Text="Restore onto a new computer" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Inspect a backup, validate the target account, restore portable data, and prepare for first sign-in."
                                               Style="{StaticResource BodyMutedStyle}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,24,0,24" Spacing="8">
                                    <TextBlock Text="1  Inspect the backup package" />
                                    <TextBlock Text="2  Confirm account and compatibility" />
                                    <TextBlock Text="3  Restore and verify the profile" />
                                </StackPanel>
                                <Button Grid.Row="3"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{x:Bind ViewModel.StartRestoreCommand}"
                                        AccessKey="R"
                                        Content="Set up restore" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE770;" Foreground="{ThemeResource AllocatorGoldBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="This computer" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.MachineDetail}" Style="{StaticResource BodyMutedStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Workflow shell -->
            <Grid x:Name="WorkflowShell" Visibility="{x:Bind ViewModel.IsWorkflowVisible, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailColumn" Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DesktopRail"
                        Grid.Column="0"
                        Grid.RowSpan="2"
                        Margin="20,20,0,20"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.WorkflowName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Margin="0,6,0,20" Text="Four guided stages" Style="{StaticResource BodyMutedStyle}" />
                        <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ViewModel.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:WorkflowStepItem">
                                    <Button Margin="0,0,0,8"
                                            Padding="10"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                            Tag="{x:Bind Stage}"
                                            Click="StepButton_Click"
                                            AutomationProperties.Name="{x:Bind Title}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{ThemeResource AllocatorAccentBrush}"
                                                    CornerRadius="2"
                                                    Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="15" />
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Row="3"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{x:Bind ViewModel.StartOverCommand}"
                                IsEnabled="{x:Bind ViewModel.IsTransferActive, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                Content="Back to start" />
                    </Grid>
                </Border>

                <Border x:Name="CompactRail"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Margin="20,12,20,0"
                        Padding="8"
                        Visibility="Collapsed"
                        Style="{StaticResource CardBorderStyle}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:WorkflowStepItem">
                                <Button Margin="3"
                                        Padding="10,7"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                        Tag="{x:Bind Stage}"
                                        Click="StepButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="13" />
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid x:Name="WorkArea" Grid.RowSpan="2" Grid.Column="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar Margin="0,0,0,12"
                             IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                             Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                             Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay, Converter={StaticResource NoticeSeverityConverter}}"
                             IsClosable="True" />

                    <Grid Grid.Row="1">
                        <!-- Setup -->
                        <Grid Visibility="{x:Bind ViewModel.IsSetup, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6" Margin="4,0,4,16">
                                <TextBlock Text="{x:Bind ViewModel.SetupTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SetupDescription, Mode=OneWay}" FontSize="16" Style="{StaticResource BodyMutedStyle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" Padding="0,0,8,16">
                                    <StackPanel Visibility="{x:Bind ViewModel.IsBackup, Mode=OneWay}" Spacing="16">
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="1. User profile" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Choose the profile to capture. System and technician accounts are excluded automatically." Style="{StaticResource BodyMutedStyle}" />
                                                <ComboBox ItemsSource="{x:Bind ViewModel.BackupProfiles}"
                                                          SelectedItem="{x:Bind ViewModel.SelectedBackupProfile, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          PlaceholderText="Select a Windows profile"
                                                          HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="User profile" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="2. Printers (optional)" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Clear any printer that should not be recorded with this backup." Style="{StaticResource BodyMutedStyle}" />
                                                <ListView ItemsSource="{x:Bind ViewModel.BackupPrinters}" MaxHeight="220" SelectionMode="None">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PrinterOption">
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{x:Bind BackupDisplayDetail}" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <TextBlock Text="No installed printers were found. You can continue without printers."
                                                           Visibility="{x:Bind ViewModel.BackupPrinters.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"
                                                           Style="{StaticResource BodyMutedStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="3. Backup destination" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Choose an external drive or transfer folder. The Allocator creates a user folder containing the archive, metadata, printer definitions, and logs." Style="{StaticResource BodyMutedStyle}" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{x:Bind ViewModel.BackupDestination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="Select destination folder"
                                                             AutomationProperties.Name="Backup destination" />
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.BrowseDestinationCommand}" Content="Browse…" AccessKey="D" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Visibility="{x:Bind ViewModel.IsRestore, Mode=OneWay}" Spacing="16">
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="1. Backup package" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Choose an Allocator .7z package. Its matching metadata is read from beside or inside the archive." Style="{StaticResource BodyMutedStyle}" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{x:Bind ViewModel.RestorePackagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="Select backup package"
                                                             AutomationProperties.Name="Backup package" />
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.BrowsePackageCommand}" Content="Browse…" AccessKey="P" />
                                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.InspectPackageCommand}" Content="Inspect" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.PackageSummary, Mode=OneWay}" Style="{StaticResource BodyMutedStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12" IsHitTestVisible="{x:Bind ViewModel.IsPackageLoaded, Mode=OneWay}">
                                                <TextBlock Text="2. Target account" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Use an existing working profile, or enter the account Windows should prepare for this restore." Style="{StaticResource BodyMutedStyle}" />
                                                <RadioButton Content="Use an existing account" GroupName="AccountMode" IsChecked="{x:Bind ViewModel.UseExistingAccount, Mode=OneWay}" Checked="ExistingAccount_Checked" />
                                                <ComboBox ItemsSource="{x:Bind ViewModel.RestoreProfiles}"
                                                          SelectedItem="{x:Bind ViewModel.SelectedRestoreProfile, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          IsEnabled="{x:Bind ViewModel.UseExistingAccount, Mode=OneWay}"
                                                          PlaceholderText="Select existing account"
                                                          HorizontalAlignment="Stretch" />
                                                <RadioButton Content="Enter an account manually" GroupName="AccountMode" IsChecked="{x:Bind ViewModel.IsManualAccount, Mode=OneWay}" Checked="ManualAccount_Checked" />
                                                <TextBox Text="{x:Bind ViewModel.ManualTargetUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{x:Bind ViewModel.IsManualAccount, Mode=OneWay}"
                                                         PlaceholderText="Short user name"
                                                         Header="Destination user" />
                                                <CheckBox Content="Domain account (ad.vassar.edu)" IsChecked="{x:Bind ViewModel.UseDomainAccount, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12" IsHitTestVisible="{x:Bind ViewModel.IsPackageLoaded, Mode=OneWay}">
                                                <TextBlock Text="3. Printers (optional)" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Select saved printers to recreate after profile files are restored." Style="{StaticResource BodyMutedStyle}" />
                                                <ListView ItemsSource="{x:Bind ViewModel.RestorePrinters}" MaxHeight="220" SelectionMode="None">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PrinterOption">
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{x:Bind RestoreDisplayDetail}" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Padding="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.BackCommand}" Content="Back" AccessKey="A" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.ContinueToReviewCommand}" IsEnabled="{x:Bind ViewModel.CanContinue, Mode=OneWay}" Content="Review plan" AccessKey="N" />
                            </Grid>
                        </Grid>

                        <!-- Review -->
                        <Grid Visibility="{x:Bind ViewModel.IsReview, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6" Margin="4,0,4,16">
                                <TextBlock Text="{x:Bind ViewModel.ReviewTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ReviewDescription}" FontSize="16" Style="{StaticResource BodyMutedStyle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid ColumnSpacing="16" Padding="0,0,8,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Migration summary" Style="{StaticResource SectionTitleStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.SummaryRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:SummaryRow">
                                                        <StackPanel Margin="0,0,0,12" Spacing="3">
                                                            <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" />
                                                            <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Readiness checks" Style="{StaticResource SectionTitleStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreflightChecks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PreflightCheck">
                                                        <Grid Margin="0,0,0,14" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="{x:Bind Status, Converter={StaticResource PreflightGlyphConverter}}" FontSize="16" AutomationProperties.Name="{x:Bind Status}" />
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{x:Bind Status}" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyMutedStyle}" IsTextSelectionEnabled="True" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Padding="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.BackCommand}" Content="Edit setup" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.BeginTransferCommand}" IsEnabled="{x:Bind ViewModel.CanBeginTransfer, Mode=OneWay}" Content="Begin transfer" AccessKey="B" />
                            </Grid>
                        </Grid>

                        <!-- Transfer -->
                        <Grid Visibility="{x:Bind ViewModel.IsTransfer, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6" Margin="4,0,4,16">
                                <TextBlock Text="{x:Bind ViewModel.TransferTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Keep this computer connected to power and storage until the operation finishes." FontSize="16" Style="{StaticResource BodyMutedStyle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="780" HorizontalAlignment="Stretch" Spacing="16" Padding="0,0,8,16">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{x:Bind ViewModel.ProgressHeadline, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Text="{x:Bind ViewModel.ProgressDetail, Mode=OneWay}" Style="{StaticResource BodyMutedStyle}" AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                            <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}" Height="6" />
                                            <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AllocatorMutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Activity" Style="{StaticResource SectionTitleStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ProgressMilestones}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:ProgressMilestone">
                                                        <Grid Margin="0,0,0,12" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" AutomationProperties.Name="{x:Bind StateLabel}" />
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyMutedStyle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Finish -->
                        <Grid Visibility="{x:Bind ViewModel.IsFinish, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="820" Spacing="20" HorizontalAlignment="Stretch" Padding="0,16,8,16">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource AllocatorSubtleBrush}" HorizontalAlignment="Left">
                                        <FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="{ThemeResource AllocatorSuccessBrush}" />
                                    </Border>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.FinishTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" AutomationProperties.LiveSetting="Assertive" />
                                        <TextBlock Text="{x:Bind ViewModel.FinishMessage, Mode=OneWay}" FontSize="16" Style="{StaticResource BodyMutedStyle}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Result" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Location" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ResultPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="Log" FontSize="12" Foreground="{ThemeResource AllocatorMutedTextBrush}" Margin="0,8,0,0" />
                                            <TextBlock Text="{x:Bind ViewModel.ResultLogPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="1" Padding="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.StartOverCommand}" Content="Start another migration" />
                                <Button Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Visibility="{x:Bind ViewModel.ShowOpenLogAction, Mode=OneWay}" Command="{x:Bind ViewModel.OpenResultLogCommand}" Content="Open log" />
                                <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Visibility="{x:Bind ViewModel.ShowOpenFolderAction, Mode=OneWay}" Command="{x:Bind ViewModel.OpenResultFolderCommand}" Content="Open backup folder" />
                                <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Visibility="{x:Bind ViewModel.ShowRebootAction, Mode=OneWay}" Command="{x:Bind ViewModel.RequestRebootCommand}" Content="Reboot computer" AccessKey="R" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RailColumn.Width" Value="0" />
                        <Setter Target="DesktopRail.Visibility" Value="Collapsed" />
                        <Setter Target="CompactRail.Visibility" Value="Visible" />
                        <Setter Target="WorkArea.(Grid.Row)" Value="1" />
                        <Setter Target="WorkArea.(Grid.RowSpan)" Value="1" />
                        <Setter Target="WorkArea.(Grid.Column)" Value="0" />
                        <Setter Target="WorkArea.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
