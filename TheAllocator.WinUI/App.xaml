<Application
    x:Class="TheAllocator.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AllocatorAccentBrush" Color="#951829" />
                    <SolidColorBrush x:Key="AllocatorAccentHoverBrush" Color="#7D1423" />
                    <SolidColorBrush x:Key="AllocatorAccentPressedBrush" Color="#641A2B" />
                    <SolidColorBrush x:Key="AllocatorAccentTextBrush" Color="White" />
                    <SolidColorBrush x:Key="AllocatorGoldBrush" Color="#A68445" />
                    <SolidColorBrush x:Key="AllocatorCardBrush" Color="#F9FFFFFF" />
                    <SolidColorBrush x:Key="AllocatorSubtleBrush" Color="#FFF7F4" />
                    <SolidColorBrush x:Key="AllocatorBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="AllocatorMutedTextBrush" Color="#5E5E5E" />
                    <SolidColorBrush x:Key="AllocatorSuccessBrush" Color="#0F6B3E" />
                    <SolidColorBrush x:Key="AllocatorWarningBrush" Color="#8A5300" />
                    <SolidColorBrush x:Key="AllocatorErrorBrush" Color="#B10E1E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AllocatorAccentBrush" Color="#951829" />
                    <SolidColorBrush x:Key="AllocatorAccentHoverBrush" Color="#7D1423" />
                    <SolidColorBrush x:Key="AllocatorAccentPressedBrush" Color="#641A2B" />
                    <SolidColorBrush x:Key="AllocatorAccentTextBrush" Color="White" />
                    <SolidColorBrush x:Key="AllocatorGoldBrush" Color="#A68445" />
                    <SolidColorBrush x:Key="AllocatorCardBrush" Color="#F9FFFFFF" />
                    <SolidColorBrush x:Key="AllocatorSubtleBrush" Color="#FFF7F4" />
                    <SolidColorBrush x:Key="AllocatorBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="AllocatorMutedTextBrush" Color="#5E5E5E" />
                    <SolidColorBrush x:Key="AllocatorSuccessBrush" Color="#0F6B3E" />
                    <SolidColorBrush x:Key="AllocatorWarningBrush" Color="#8A5300" />
                    <SolidColorBrush x:Key="AllocatorErrorBrush" Color="#B10E1E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AllocatorAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AllocatorAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AllocatorAccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AllocatorAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AllocatorGoldBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AllocatorCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AllocatorSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AllocatorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AllocatorMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AllocatorSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AllocatorWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AllocatorErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AllocatorAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AllocatorAccentTextBrush}" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AllocatorCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AllocatorBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="BodyMutedStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AllocatorMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
